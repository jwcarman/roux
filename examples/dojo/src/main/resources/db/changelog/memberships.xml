<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- The school's rank ladder, ordered by position from 1. Names are unique ignoring case. -->
  <!-- A student's memberships (one current: end_date null) and the payments recorded on them. -->
  <changeSet id="membership" author="dojo">
    <createTable tableName="membership">
      <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
      <column name="version" type="bigint"><constraints nullable="false"/></column>
      <column name="student_id" type="uuid">
        <constraints nullable="false" foreignKeyName="membership_student_fk" references="student(id)"/>
      </column>
      <column name="plan_id" type="uuid">
        <constraints nullable="false" foreignKeyName="membership_plan_fk" references="plan(id)"/>
      </column>
      <column name="start_date" type="date"><constraints nullable="false"/></column>
      <column name="end_date" type="date"/>
      <column name="created_date" type="timestamptz"/>
      <column name="modified_date" type="timestamptz"/>
      <column name="created_by" type="varchar(64)"/>
      <column name="modified_by" type="varchar(64)"/>
    </createTable>
    <sql>create unique index membership_current_key on membership (student_id) where end_date is null</sql>
    <createIndex tableName="membership" indexName="membership_plan_idx">
      <column name="plan_id"/>
    </createIndex>
  </changeSet>

  <changeSet id="payment" author="dojo">
    <createTable tableName="payment">
      <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
      <column name="version" type="bigint"><constraints nullable="false"/></column>
      <column name="membership_id" type="uuid">
        <constraints nullable="false" foreignKeyName="payment_membership_fk" references="membership(id)"/>
      </column>
      <column name="periods" type="int"><constraints nullable="false"/></column>
      <column name="amount_minor_units" type="bigint"><constraints nullable="false"/></column>
      <column name="amount_currency" type="varchar(3)"><constraints nullable="false"/></column>
      <column name="taken_on" type="date"><constraints nullable="false"/></column>
      <column name="method" type="varchar(10)"><constraints nullable="false"/></column>
      <column name="note" type="varchar(200)"/>
      <column name="created_date" type="timestamptz"/>
      <column name="modified_date" type="timestamptz"/>
      <column name="created_by" type="varchar(64)"/>
      <column name="modified_by" type="varchar(64)"/>
    </createTable>
    <sql>alter table payment add constraint payment_periods_check check (periods between 1 and 12)</sql>
    <createIndex tableName="payment" indexName="payment_membership_idx">
      <column name="membership_id"/>
    </createIndex>
    <createIndex tableName="payment" indexName="payment_taken_on_idx">
      <column name="taken_on"/>
    </createIndex>
  </changeSet>

  <!-- Paid through, computed (never stored): the start, plus the periods paid as whole months or
       years at once, minus a day. PaidThrough.of does the same in Java. -->
  <changeSet id="membership-paid-through" author="dojo">
    <createView viewName="membership_paid_through">
      select m.id as membership_id, m.student_id, m.start_date, m.end_date,
             coalesce(sum(pay.periods), 0)::int as paid_periods,
             (m.start_date
               + case p.period
                   when 'YEARLY' then make_interval(years => coalesce(sum(pay.periods), 0)::int)
                   else make_interval(months => coalesce(sum(pay.periods), 0)::int)
                 end
               - interval '1 day')::date as paid_through
      from membership m
      join plan p on p.id = m.plan_id
      left join payment pay on pay.membership_id = m.id
      group by m.id, p.period
    </createView>
  </changeSet>
  <!-- The student list gains the current membership: its plan, paid through, and whether there is one. -->
  <changeSet id="student-list-with-membership" author="dojo">
    <dropView viewName="student_list"/>
    <createView viewName="student_list">
      select s.id, s.version, s.first_name, s.last_name, s.email, s.phone, s.birth_date,
             s.start_date, s.status,
             lower(s.last_name) || ' ' || lower(s.first_name) as name_key,
             r.id as rank_id, r.name::varchar as rank_name, r.colour::varchar as rank_colour,
             r.position as rank_position, r.version as rank_version,
             pl.name::varchar as plan_name, mpt.paid_through,
             (mpt.membership_id is not null) as has_membership
      from student s
      left join student_current_rank c on c.student_id = s.id
      left join rank r on r.id = c.rank_id
      left join membership_paid_through mpt on mpt.student_id = s.id and mpt.end_date is null
      left join membership m on m.id = mpt.membership_id
      left join plan pl on pl.id = m.plan_id
    </createView>
  </changeSet>

</databaseChangeLog>
