<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- How the app looks, as the owner chose it: at most one row (AppTheme.ID). No row means the
       defaults, which are the template's own look. -->
  <changeSet id="app-theme" author="dojo">
    <createTable tableName="app_theme">
      <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
      <column name="version" type="bigint"><constraints nullable="false"/></column>
      <column name="palette" type="varchar(16)"><constraints nullable="false"/></column>
      <column name="brand_color" type="varchar(7)"><constraints nullable="false"/></column>
      <column name="shape" type="varchar(16)"><constraints nullable="false"/></column>
      <column name="heading_font" type="varchar(16)"><constraints nullable="false"/></column>
      <column name="body_font" type="varchar(16)"><constraints nullable="false"/></column>
      <column name="app_name" type="varchar(60)"><constraints nullable="false"/></column>
      <column name="created_date" type="timestamptz"/>
      <column name="modified_date" type="timestamptz"/>
      <column name="created_by" type="varchar(64)"/>
      <column name="modified_by" type="varchar(64)"/>
    </createTable>
  </changeSet>
</databaseChangeLog>
