<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- The weekly timetable: a class repeats every weekday between two wall-clock times. The
       instructor is a member's id with no foreign key: members are deactivated, never removed, and
       the name is read from the directory. -->
  <changeSet id="school-class" author="dojo">
    <createTable tableName="school_class">
      <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
      <column name="version" type="bigint"><constraints nullable="false"/></column>
      <column name="name" type="varchar(60)"><constraints nullable="false"/></column>
      <column name="weekday" type="varchar(9)"><constraints nullable="false"/></column>
      <column name="starts_at" type="time"><constraints nullable="false"/></column>
      <column name="ends_at" type="time"><constraints nullable="false"/></column>
      <column name="instructor_id" type="uuid"/>
      <column name="created_date" type="timestamptz"/>
      <column name="modified_date" type="timestamptz"/>
      <column name="created_by" type="varchar(64)"/>
      <column name="modified_by" type="varchar(64)"/>
    </createTable>
    <sql>alter table school_class add constraint school_class_ends_after_start check (ends_at &gt; starts_at)</sql>
  </changeSet>
</databaseChangeLog>
