<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- A student's attendance at a class on a date. A class with attendance cannot be removed (the
       foreign key is the last line of defence; ClassRemovalCheck says why), and a student attends
       a class on a date once: the unique constraint is what makes a double tap, or two devices,
       leave one row. -->
  <changeSet id="attendance" author="dojo">
    <createTable tableName="attendance">
      <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
      <column name="version" type="bigint"><constraints nullable="false"/></column>
      <column name="class_id" type="uuid">
        <constraints nullable="false" foreignKeyName="fk_attendance_class" references="school_class(id)"/>
      </column>
      <column name="student_id" type="uuid">
        <constraints nullable="false" foreignKeyName="fk_attendance_student" references="student(id)"/>
      </column>
      <column name="attended_on" type="date"><constraints nullable="false"/></column>
      <column name="created_date" type="timestamptz"/>
      <column name="modified_date" type="timestamptz"/>
      <column name="created_by" type="varchar(64)"/>
      <column name="modified_by" type="varchar(64)"/>
    </createTable>
    <addUniqueConstraint tableName="attendance" columnNames="class_id, student_id, attended_on"
        constraintName="attendance_class_student_day_key"/>
    <createIndex tableName="attendance" indexName="attendance_student_idx">
      <column name="student_id"/>
      <column name="attended_on"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
