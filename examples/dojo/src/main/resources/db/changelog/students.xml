<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="student" author="dojo">
    <createTable tableName="student">
      <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
      <column name="version" type="bigint"><constraints nullable="false"/></column>
      <column name="first_name" type="varchar(80)"><constraints nullable="false"/></column>
      <column name="last_name" type="varchar(80)"><constraints nullable="false"/></column>
      <column name="email" type="varchar(320)"/>
      <column name="phone" type="varchar(30)"/>
      <column name="birth_date" type="date"/>
      <column name="start_date" type="date"><constraints nullable="false"/></column>
      <column name="status" type="varchar(16)"><constraints nullable="false"/></column>
      <column name="created_date" type="timestamptz"/>
      <column name="modified_date" type="timestamptz"/>
      <column name="created_by" type="varchar(64)"/>
      <column name="modified_by" type="varchar(64)"/>
    </createTable>
  </changeSet>

  <!-- The student list: one row per student, with the rank of their latest promotion. Until
       promotions exist every student has no rank. name_key is what sorting by name sorts on. -->
  <changeSet id="student-list" author="dojo">
    <createView viewName="student_list">
      select s.id, s.version, s.first_name, s.last_name, s.email, s.phone, s.birth_date,
             s.start_date, s.status,
             lower(s.last_name) || ' ' || lower(s.first_name) as name_key,
             null::uuid as rank_id, null::varchar as rank_name, null::varchar as rank_colour,
             null::int as rank_position, null::bigint as rank_version
      from student s
    </createView>
  </changeSet>
</databaseChangeLog>
