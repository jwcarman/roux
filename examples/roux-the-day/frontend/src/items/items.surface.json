{
  "id": "items",
  "components": [
    {
      "id": "root",
      "component": "Column",
      "children": ["title", "subtitle", "counts", "filters", "addCard", "table"]
    },
    {
      "id": "title",
      "component": "Heading",
      "text": "Items",
      "size": "xl"
    },
    {
      "id": "subtitle",
      "component": "Text",
      "text": "Everything the team has on.",
      "muted": true
    },
    {
      "id": "counts",
      "component": "Row",
      "children": ["openCard", "overdueCard", "todayCard"]
    },
    {
      "id": "openCard",
      "component": "Card",
      "children": ["openStat"]
    },
    {
      "id": "openStat",
      "component": "Stat",
      "label": "Open",
      "value": {
        "@path": "/counts/open"
      }
    },
    {
      "id": "overdueCard",
      "component": "Card",
      "children": ["overdueStat"]
    },
    {
      "id": "overdueStat",
      "component": "Stat",
      "label": "Overdue",
      "value": {
        "@path": "/counts/overdue"
      },
      "tone": "danger"
    },
    {
      "id": "todayCard",
      "component": "Card",
      "children": ["todayStat"]
    },
    {
      "id": "todayStat",
      "component": "Stat",
      "label": "Today",
      "value": {
        "@path": "/counts/today"
      },
      "tone": "accent"
    },
    {
      "id": "filters",
      "component": "Card",
      "children": ["filterRows"]
    },
    {
      "id": "filterRows",
      "component": "Column",
      "children": ["filterTop", "filterBottom"]
    },
    {
      "id": "filterTop",
      "component": "Row",
      "children": ["searchForm", "assignee"]
    },
    {
      "id": "searchForm",
      "component": "Form",
      "weight": 2,
      "children": ["search"]
    },
    {
      "id": "search",
      "component": "InputField",
      "label": "Search",
      "value": {
        "@path": "/itemsArgs/search"
      }
    },
    {
      "id": "assignee",
      "component": "FilterChips",
      "label": "Assigned to",
      "value": {
        "@path": "/itemsArgs/assignee"
      },
      "options": [
        {
          "value": "anyone",
          "label": "Anyone"
        },
        {
          "value": "me",
          "label": "Mine"
        }
      ]
    },
    {
      "id": "filterBottom",
      "component": "Row",
      "children": ["when", "status"]
    },
    {
      "id": "when",
      "component": "FilterChips",
      "label": "When",
      "value": {
        "@path": "/itemsArgs/when"
      },
      "options": [
        {
          "value": "all",
          "label": "Any time"
        },
        {
          "value": "overdue",
          "label": "Overdue"
        },
        {
          "value": "today",
          "label": "Today"
        },
        {
          "value": "week",
          "label": "This week"
        }
      ]
    },
    {
      "id": "status",
      "component": "FilterChips",
      "label": "Status",
      "value": {
        "@path": "/itemsArgs/status"
      },
      "options": [
        {
          "value": "",
          "label": "Any status"
        },
        {
          "value": "open",
          "label": "Open"
        },
        {
          "value": "done",
          "label": "Done"
        }
      ]
    },
    {
      "id": "addCard",
      "component": "Card",
      "children": ["addForm"]
    },
    {
      "id": "addForm",
      "component": "Form",
      "children": ["addRow", "addHint"]
    },
    {
      "id": "addRow",
      "component": "Row",
      "children": ["draftTitle", "draftDay", "add"]
    },
    {
      "id": "draftTitle",
      "component": "InputField",
      "label": "New item",
      "required": true,
      "weight": 2,
      "value": {
        "@path": "/draft/title"
      },
      "serverError": {
        "@path": "/errors/title"
      },
      "@checks": [
        {
          "condition": {
            "@call": "required",
            "args": {
              "value": {
                "@path": "/draft/title"
              }
            }
          },
          "message": "Must not be blank"
        }
      ]
    },
    {
      "id": "draftDay",
      "component": "InputField",
      "label": "Day",
      "type": "date",
      "value": {
        "@path": "/draft/day"
      },
      "serverError": {
        "@path": "/errors/day"
      }
    },
    {
      "id": "add",
      "component": "Button",
      "label": "Add item",
      "action": {
        "event": {
          "name": "addItem",
          "context": {
            "title": {
              "@path": "/draft/title"
            },
            "day": {
              "@path": "/draft/day"
            }
          }
        }
      }
    },
    {
      "id": "addHint",
      "component": "Text",
      "text": "Leave the day blank for today.",
      "muted": true
    },
    {
      "id": "table",
      "component": "DataTable",
      "rows": {
        "@path": "/items"
      },
      "pageIndex": {
        "@path": "/itemsArgs/pageIndex"
      },
      "sortBy": {
        "@path": "/itemsArgs/sortBy"
      },
      "sortDirection": {
        "@path": "/itemsArgs/sortDirection"
      },
      "emptyText": "No items yet",
      "columns": [
        {
          "header": "Day",
          "field": "day",
          "format": "date",
          "sort": "DAY"
        },
        {
          "header": "Time",
          "field": "at",
          "format": "time",
          "emptyText": "All day"
        },
        {
          "header": "Title",
          "field": "title",
          "sort": "TITLE",
          "link": {
            "to": "/items/$itemId",
            "params": {
              "itemId": "id"
            }
          }
        },
        {
          "header": "Assigned to",
          "field": "assigneeNames",
          "format": "list",
          "sort": "ASSIGNEE"
        },
        {
          "header": "Status",
          "field": "status",
          "format": "badge",
          "tones": {
            "Open": "info",
            "Done": "success"
          }
        }
      ]
    }
  ]
}
