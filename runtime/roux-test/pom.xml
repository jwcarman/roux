<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jwcarman.roux</groupId>
        <artifactId>roux-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>roux-test</artifactId>

    <name>Roux - Test</name>
    <description>The test kit for a roux app: the whole app on PostgreSQL, members signed in with a role, a settable clock, and captured mail. Add it with test scope.</description>

    <dependencies>
        <dependency>
            <groupId>org.jwcarman.roux</groupId>
            <artifactId>roux-roles</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- WhoMockMvcBrowser: a browser signed in as a member -->
            <groupId>org.jwcarman.who</groupId>
            <artifactId>who-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
        <dependency>
            <!-- MockMvc for @AppTest -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
        </dependency>
        <dependency>
            <!-- the test database's server; Testcontainers' core runs Mailpit -->
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
        </dependency>
        <dependency>
            <!-- TestDatabase creates each database over JDBC -->
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- the kit's own tests: an application as roux's starter makes it -->
        <dependency>
            <groupId>org.jwcarman.roux</groupId>
            <artifactId>roux-spring-boot-starter</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.who</groupId>
            <artifactId>who-email-smtp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
