<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- OWNER holds every permission there is: each module grants its own to it in its own changelog.
         who grants nothing, so roux grants who-admin's (the starter brings who-admin). Roles are
         named, never referred to by id, and only what is missing is inserted, so a database whose
         OWNER an app made itself gains nothing twice. -->
    <changeSet id="roux-roles-1" author="roux">
        <sql>
            INSERT INTO who_role (id, name) VALUES (gen_random_uuid(), 'OWNER') ON CONFLICT (name) DO NOTHING;
            INSERT INTO who_role_permission (role_id, permission)
              SELECT r.id, p.permission FROM who_role r
              CROSS JOIN (VALUES ('who.identities.read'), ('who.identities.manage')) AS p(permission)
              WHERE r.name = 'OWNER'
              ON CONFLICT DO NOTHING;
        </sql>
    </changeSet>
</databaseChangeLog>
