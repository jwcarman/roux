<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jwcarman.roux</groupId>
        <artifactId>roux-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>roux-spring-boot-starter</artifactId>

    <name>Roux - Spring Boot Starter</name>
    <description>Convenience starter that pulls in Roux (problems, validation, SPA, JPA and email support), who, jpa-utils and their auto-configuration</description>

    <dependencies>
        <dependency>
            <groupId>org.jwcarman.roux</groupId>
            <artifactId>roux-autoconfigure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.roux</groupId>
            <artifactId>roux-problems</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.roux</groupId>
            <artifactId>roux-validation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.roux</groupId>
            <artifactId>roux-spa</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.roux</groupId>
            <artifactId>roux-jpa</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.roux</groupId>
            <artifactId>roux-email</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.roux</groupId>
            <artifactId>roux-roles</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.who</groupId>
            <artifactId>who-spring-boot-starter</artifactId>
        </dependency>
        <!-- a roux app signs in with email links (and typed codes) and passkeys; who-email renders its mail (an app adds
             who-email-smtp, or its own WhoEmailSender, to deliver it) -->
        <dependency>
            <groupId>org.jwcarman.who</groupId>
            <artifactId>who-email-link</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.who</groupId>
            <artifactId>who-email</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.who</groupId>
            <artifactId>who-passkey</artifactId>
        </dependency>
        <!-- every roux app manages people: who's admin endpoints, and the guard that keeps someone able to -->
        <dependency>
            <groupId>org.jwcarman.who</groupId>
            <artifactId>who-admin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.jpa</groupId>
            <artifactId>jpa-utils</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- A starter has no code. As Spring Boot's own starters do, its jar carries the
                 licence, so the jar is not empty. -->
            <resource>
                <directory>${project.basedir}/../..</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
        </resources>
    </build>
</project>
