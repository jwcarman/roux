<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- The app's users: who's identity, with the name the app shows. Deleting the identity deletes
         its user. Nothing who owns (status, addresses, roles) is copied here. -->
    <changeSet id="roux-users-1" author="roux">
        <createTable tableName="roux_user">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="roux_user_identity_fk"
                             referencedTableName="who_identity" referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>
            <column name="version" type="bigint"><constraints nullable="false"/></column>
            <column name="display_name" type="varchar(80)"><constraints nullable="false"/></column>
            <column name="created_date" type="timestamptz"/>
            <column name="modified_date" type="timestamptz"/>
            <column name="created_by" type="varchar(64)"/>
            <column name="modified_by" type="varchar(64)"/>
        </createTable>
    </changeSet>
    <!-- The directory: each user as the app shows them, read from who every time. The email is the
         identity's oldest address (lowest credential id, as who's findOldestFor), the role the first
         by name (roux keeps one), and a user is invited until who holds any session for them. -->
    <changeSet id="roux-users-2" author="roux">
        <createView viewName="roux_user_directory" replaceIfExists="true">
            select u.id,
                   u.version,
                   u.display_name,
                   (select e.address
                      from who_credential_identity ci
                      join who_email_credential e on e.id = ci.credential_id
                     where ci.identity_id = u.id
                     order by e.id
                     limit 1) as email,
                   (select r.name
                      from who_identity_role ir
                      join who_role r on r.id = ir.role_id
                     where ir.identity_id = u.id
                     order by r.name
                     limit 1) as role,
                   case when i.status = 'ACTIVE' then 'ACTIVE' else 'DEACTIVATED' end as status,
                   i.created_at as joined_at,
                   not exists (select 1 from who_session s where s.identity_id = u.id) as invited
              from roux_user u
              join who_identity i on i.id = u.id
        </createView>
    </changeSet>
</databaseChangeLog>
