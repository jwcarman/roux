// Generated from items.surface.json and the typed catalog. Do not edit.
import type { IsoDate, Money, Pagination } from "@jwcarman/roux-web/surface";

/** What the items surface shows, by top-level path: each is bound to a query or kept locally. */
export interface ItemsSurfaceData {
  counts: {
    open: number;
    overdue: number;
    today: number;
  };
  itemsArgs: {
    search: string;
    when: string;
    status: string;
    assignee: string;
    pageIndex: number;
    sortBy: string;
    sortDirection: string;
  };
  items: {
    data: {
      day: IsoDate | null;
      at: string | null;
      title: string | null;
      id: string;
      assigneeNames: string[];
      status: string | null;
    }[];
    pagination: Pagination;
  };
  draft: {
    title: string;
    day: string;
  };
  errors: {
    title: string;
    day: string;
  };
}

/** What each of the items surface's events carries. */
export interface ItemsSurfaceEvents {
  addItem: {
    title: string;
    day: string;
  };
}
