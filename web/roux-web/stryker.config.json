{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/testing/{contracts,css,fakeServer,location,router,validationMessages}.*",
    "!src/surface/testSurface.tsx",
    "!src/**/*.test.*",
    "!src/**/*.test-d.ts",
    "!src/**/testdata/**",
    "!src/**/index.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "thresholds": {
    "break": 100
  },
  "tsconfigFile": "tsconfig.stryker-skip.json",
  "disableTypeChecks": "src/**/!(*.gen).{ts,tsx}",
  "incremental": true,
  "incrementalFile": "../../.mutation-history/stryker-incremental.json"
}
