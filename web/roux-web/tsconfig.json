{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": [
    "src/testing/contracts.ts",
    "src/testing/css.ts",
    "src/testing/fakeServer.ts",
    "src/testing/location.ts",
    "src/testing/router.tsx",
    "src/testing/validationMessages.ts",
    "src/surface/testSurface.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
