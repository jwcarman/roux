  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    "./problem": { "types": "./dist/problem/index.d.ts", "import": "./dist/problem/index.js" },
    "./api": { "types": "./dist/api/index.d.ts", "import": "./dist/api/index.js" },
