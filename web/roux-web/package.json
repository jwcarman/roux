{
  "name": "@jwcarman/roux-web",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwcarman/roux.git",
    "directory": "web/roux-web"
  },
  "homepage": "https://github.com/jwcarman/roux#readme",
  "bugs": "https://github.com/jwcarman/roux/issues",
  "sideEffects": [
    "./dist/form/rules.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./problem": {
      "types": "./dist/problem/index.d.ts",
      "import": "./dist/problem/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./paging": {
      "types": "./dist/paging/index.d.ts",
      "import": "./dist/paging/index.js"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "import": "./dist/table/index.js"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "import": "./dist/feedback/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js"
    },
    "./dates": {
      "types": "./dist/dates/index.d.ts",
      "import": "./dist/dates/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json --emitDeclarationOnly && vite build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mutate": "stryker run",
    "format": "../lint-tools/node_modules/.bin/prettier --write .",
    "format:check": "../lint-tools/node_modules/.bin/prettier --check .",
    "lint": "../lint-tools/node_modules/.bin/eslint -c ../lint-tools/eslint.config.mjs ."
  },
