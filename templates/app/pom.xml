<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.3</version>
        <relativePath/>
    </parent>

    <groupId>app</groupId>
    <artifactId>roux-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>roux-app</name>

    <properties>
        <java.version>25</java.version>
        <!-- roux's version: roux-bom pins roux's modules, who and jpa-utils to it. -->
        <roux.version>0.3.0-SNAPSHOT</roux.version>
        <spotless.plugin.version>3.11.0</spotless.plugin.version>
        <google-java-format.version>1.35.0</google-java-format.version>
        <frontend.plugin.version>1.15.1</frontend.plugin.version>
        <jacoco.plugin.version>0.8.16</jacoco.plugin.version>
        <pitest.plugin.version>1.30.2</pitest.plugin.version>
        <pitest-junit5.plugin.version>1.2.3</pitest-junit5.plugin.version>
        <!-- PIT's file history (incremental analysis) lives in this plugin, not in pitest itself. -->
        <pitest-history.plugin.version>0.0.1</pitest-history.plugin.version>
        <!-- JaCoCo's agent, which jacoco:prepare-agent writes here; empty when JaCoCo is skipped. -->
        <jacocoArgLine></jacocoArgLine>
        <node.version>v24.15.0</node.version>
        <!-- ./mvnw spring-boot:run is development over http://localhost (application-dev.yml). -->
        <spring-boot.run.profiles>dev</spring-boot.run.profiles>
        <!-- Set by the skip-tests and skip-its profiles below. -->
        <frontend.test.skip>false</frontend.test.skip>
        <e2e.skip>false</e2e.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- roux's BOM pins roux, who and jpa-utils; Spring Boot's versions come from the parent. -->
            <dependency>
                <groupId>org.jwcarman.roux</groupId>
                <artifactId>roux-bom</artifactId>
                <version>${roux.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Brings who (email links and passkeys), jpa-utils, validation and Spring MVC. -->
        <dependency>
            <groupId>org.jwcarman.roux</groupId>
            <artifactId>roux-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <!-- The owner changes the app's look on the Appearance page; not in the starter, so a
                 fixed-brand app leaves it out and sets roux.theme.* instead. -->
            <groupId>org.jwcarman.roux</groupId>
            <artifactId>roux-theme</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jwcarman.jpa</groupId>
            <artifactId>jpa-utils</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- delivers who's emails over SMTP, through the spring-boot-starter-mail above -->
        <dependency>
            <groupId>org.jwcarman.who</groupId>
            <artifactId>who-email-smtp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>
        <!-- Liquibase locks with a PostgreSQL advisory lock, not a table: a start that dies
             mid-migration leaves no stale lock for the next one to wait on. -->
        <dependency>
            <groupId>com.github.blagerweij</groupId>
            <artifactId>liquibase-sessionlock</artifactId>
        </dependency>
        <!-- Sessions in PostgreSQL (Spring Session JDBC); the tables come from Liquibase. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <!-- roux's test kit: the whole app on PostgreSQL, signed-in users, a settable clock, mail -->
            <groupId>org.jwcarman.roux</groupId>
            <artifactId>roux-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <!-- The built SPA, served by Spring Boot as static content. -->
                <directory>frontend/dist</directory>
                <targetPath>static</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <!-- A native build's AOT step (process-aot) writes generated classes (named with "__",
                         such as Spring Data's __Accessor_ classes, or $$SpringCGLIB$$ proxies) and native metadata into
                         target/classes. A later JVM build would keep them, and a stale one fails at runtime
                         once an entity changes. So every build starts without them, and a native build
                         makes them again; no "mvn clean" between the two. -->
                    <execution>
                        <id>remove-aot-output</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>**/*__*.class</include>
                                        <include>**/*$$SpringCGLIB$$*.class</include>
                                        <include>META-INF/native-image/**</include>
                                    </includes>
                                </fileset>
                                <!-- The test AOT step (nativeTest) writes the same into target/test-classes. -->
                                <fileset>
                                    <directory>${project.build.testOutputDirectory}</directory>
                                    <includes>
                                        <include>**/*__*.class</include>
                                        <include>**/*$$SpringCGLIB$$*.class</include>
                                        <include>META-INF/native-image/**</include>
                                    </includes>
                                </fileset>
                                <fileset>
                                    <directory>${project.build.directory}/spring-aot</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Runs E2eIT in integration-test; verify fails the build on its failure. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Mockito and Byte Buddy load as agents named up front (the JDK warns about agents
                 attached at run time); maven-dependency-plugin's properties goal names their jars. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{jacocoArgLine} -javaagent:"${org.mockito:mockito-core:jar}" -javaagent:"${net.bytebuddy:byte-buddy-agent:jar}" -Xshare:off</argLine>
                </configuration>
            </plugin>
            <!-- JDK 23+ runs no annotation processor found only on the classpath; name Lombok's,
                 at the version Spring Boot manages. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- every javac warning, printed in full -->
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                    <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend.plugin.version}</version>
                <configuration>
                    <workingDirectory>frontend</workingDirectory>
                    <installDirectory>${project.build.directory}</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-coverage</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <skip>${frontend.test.skip}</skip>
                            <arguments>run coverage</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                    <!-- The Playwright suite (e2e/), run by E2eIT. -->
                    <execution>
                        <id>e2e-npm-ci</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>pre-integration-test</phase>
                        <configuration>
                            <skip>${e2e.skip}</skip>
                            <workingDirectory>e2e</workingDirectory>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>e2e-install-chromium</id>
                        <goals>
                            <goal>npx</goal>
                        </goals>
                        <phase>pre-integration-test</phase>
                        <configuration>
                            <skip>${e2e.skip}</skip>
                            <workingDirectory>e2e</workingDirectory>
                            <arguments>playwright install chromium</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Every line and every branch covered, or verify fails. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <!-- The app's own classes: not the ones a native build's AOT step generates into
                     target/classes (named with "__", or Spring CGLIB proxies), for the app or the
                     libraries it uses. -->
                <configuration>
                    <propertyName>jacocoArgLine</propertyName>
                    <includes>
                        <include>app/**</include>
                    </includes>
                    <excludes>
                        <exclude>**/*__*</exclude>
                        <exclude>**/*$$SpringCGLIB$$*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- google-java-format; ./mvnw spotless:apply writes it. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.plugin.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>GOOGLE</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <importOrder>
                            <order>java,javax,jakarta,org,com,</order>
                        </importOrder>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Mutation testing: ./mvnw -Ppit verify. Any surviving mutant fails the build. Incremental:
             a mutant whose class and covering tests are unchanged keeps its last result, kept in
             .mutation-history/ (git-ignored; delete it for a full run). The report is
             target/pit-reports/index.html. -->
        <profile>
            <id>pit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.plugin.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.plugin.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-history-plugin</artifactId>
                                <version>${pitest-history.plugin.version}</version>
                                <!-- pitest itself comes from pitest-maven, at the version pinned above -->
                                <exclusions>
                                    <exclusion>
                                        <groupId>*</groupId>
                                        <artifactId>*</artifactId>
                                    </exclusion>
                                </exclusions>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>app.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>app.*</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>app.E2eIT</param>
                            </excludedTestClasses>
                            <jvmArgs>
                                <value>-javaagent:${org.mockito:mockito-core:jar}</value>
                                <value>-javaagent:${net.bytebuddy:byte-buddy-agent:jar}</value>
                                <value>-Xshare:off</value>
                            </jvmArgs>
                            <threads>2</threads>
                            <mutationThreshold>100</mutationThreshold>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <timestampedReports>false</timestampedReports>
                            <historyInputFile>${project.basedir}/.mutation-history/pit.bin</historyInputFile>
                            <historyOutputFile>${project.basedir}/.mutation-history/pit.bin</historyOutputFile>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                        </configuration>
                        <executions>
                            <execution>
                                <id>pit</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Only inside roux's repository, where the frontend links roux-web's source
             (file:../../../web/roux-web): roux-web is built first, from roux's npm workspace. -->
        <profile>
            <id>roux-repository</id>
            <activation>
                <file>
                    <exists>${basedir}/../../web/roux-web/package.json</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend.plugin.version}</version>
                        <configuration>
                            <installDirectory>${project.build.directory}</installDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>roux-web-npm-ci</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <workingDirectory>../../web</workingDirectory>
                                    <arguments>ci</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>roux-web-build</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <workingDirectory>../../web</workingDirectory>
                                    <arguments>run build -w @jwcarman/roux-web</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- -DskipTests skips Vitest and the Playwright setup too; -DskipITs skips the setup. -->
        <profile>
            <id>skip-tests</id>
            <activation>
                <property>
                    <name>skipTests</name>
                </property>
            </activation>
            <properties>
                <frontend.test.skip>true</frontend.test.skip>
                <e2e.skip>true</e2e.skip>
            </properties>
        </profile>
        <profile>
            <id>skip-its</id>
            <activation>
                <property>
                    <name>skipITs</name>
                </property>
            </activation>
            <properties>
                <e2e.skip>true</e2e.skip>
            </properties>
        </profile>
        <!--
          The native binary (target/${project.artifactId}). Builds on spring-boot-starter-parent's own
          native profile (process-aot, reachability metadata) and compiles at package.
          Needs GraalVM 25 as JAVA_HOME.
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          The native binary, then E2eIT against it: the same Playwright suite, with the binary
          started as a process (-Dapp.binary) instead of Spring in-process. A profile cannot
          activate another, so this one repeats what the parent's native profile sets up.
        -->
        <profile>
            <id>native-e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>add-reachability-metadata</id>
                                <goals>
                                    <goal>add-reachability-metadata</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <app.binary>${project.build.directory}/${project.artifactId}</app.binary>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          E2eIT against the jar on GraalVM's JVM under the tracing agent (-Dapp.trace-jar): records
          the reflection, resource and proxy metadata the suite exercises into target/native-trace.
          Needs GraalVM 25 as JAVA_HOME. See scripts/trace.sh.
        -->
        <profile>
            <id>native-trace</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <app.trace-jar>${project.build.directory}/${project.build.finalName}.jar</app.trace-jar>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          With native or native-e2e: builds the binary with the metadata native-trace recorded.
          That metadata is a measurement of what who and its stack are missing, not the app's to
          ship; it stays under target/.
        -->
        <profile>
            <id>traced</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <buildArgs>
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                <buildArg>-H:ConfigurationFileDirectories=${project.build.directory}/native-trace</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          The Java tests compiled into a native image and run there: ./mvnw -PnativeTest test.
          Spring Boot's parent has a profile of this name (process-test-aot and the native test
          goal); naming it turns on both, and this one adds the plugin that runs that goal.
          Needs GraalVM 25 as JAVA_HOME.
        -->
        <profile>
            <id>nativeTest</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
