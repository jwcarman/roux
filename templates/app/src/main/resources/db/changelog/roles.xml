<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- The app's roles and what each grants. OWNER is roux's: roux-roles' changelog creates it and
       grants who-admin's permissions, roux-users grants it users.*, and roux-theme grants it
       theme.manage. Roles are named, never referred to by id. A new permission is a constant in
       identity/Permissions (the first one starts that class) and a changeset of its own here (a changeset that has run is never edited);
       PermissionsTest checks they agree. -->
  <changeSet id="app-roles-1" author="app">
    <sql>
        INSERT INTO who_role (id, name) VALUES (gen_random_uuid(), 'USER')
          ON CONFLICT (name) DO NOTHING;
        INSERT INTO who_role_permission (role_id, permission)
          SELECT r.id, 'users.read' FROM who_role r WHERE r.name = 'USER'
          ON CONFLICT DO NOTHING;
    </sql>
  </changeSet>
</databaseChangeLog>
